# Production / release-build public URL contract.
# Copy to CI secrets or `.env.production.local` — never commit real secrets here.
# Only non-secret NEXT_PUBLIC_* values belong in the browser bundle.
#
# `npm run build` sets NODE_ENV=production. lib/env.ts then requires these three
# URLs and rejects localhost / 127.0.0.1 / ::1. Do not weaken that guard.
#
# Note: a local `.env.local` with loopback URLs overrides file-based production
# env during `next build`. Prefer shell/CI environment variables for release builds,
# or temporarily unset loopback overrides. Validate with: npm run release:env

NEXT_PUBLIC_IDENTITY_API_BASE_URL=https://identity.example/api/v1
NEXT_PUBLIC_STAYS_API_BASE_URL=https://stays.example/api/v1
NEXT_PUBLIC_SITE_URL=https://www.nexastays.ma

# Must not be "mock" for release certification (npm run release:env).
# Align with backend STAYS_PAYMENT_PROVIDER=cmi in production; dogfood may use mock.
NEXT_PUBLIC_STAYS_PAYMENT_PROVIDER=cmi

# Required for release certification (HTTPS or same-origin path).
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://www.nexastays.ma/api/analytics/events
# NEXT_PUBLIC_ERROR_REPORTING_ENDPOINT=https://www.nexastays.ma/api/client-errors

# Must remain unset / false in production.
# NEXT_PUBLIC_DISABLE_PWA=true

# Legacy single-backend URL — must be absent in production.
# NEXT_PUBLIC_API_BASE_URL=
