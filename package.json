{
  "name": "nexa-stays-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-safe.mjs",
    "dev:quick": "node scripts/dev-safe.mjs --quick",
    "dev:recover": "npm run clean:next && node scripts/dev-safe.mjs --force",
    "dev:turbo": "node scripts/dev-safe.mjs --turbo",
    "clean:next": "node -e \"const fs=require('fs');['.next','.next-dev','node_modules/.cache'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}})\"",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=high",
    "audit:osv": "npx --yes @google/osv-scanner@latest -r . || npx --yes osv-scanner@latest -r .",
    "validate:explore-catalog": "npx --yes tsx scripts/validate-explore-catalog.ts",
    "check:text-encoding": "npx --yes tsx scripts/check-text-encoding.ts",
    "import:explore-city": "npx --yes tsx scripts/import-explore-city.ts",
    "generate:pwa-icons": "npx --yes tsx scripts/generate-pwa-icons.ts",
    "verify:pwa-assets": "npx --yes tsx scripts/verify-pwa-assets.ts",
    "generate:pwa": "npm run generate:pwa-icons && npm run verify:pwa-assets",
    "measure:homepage": "node scripts/measure-homepage.mjs",
    "check:locales": "node scripts/check-locale-parity.mjs",
    "sync:locales": "node scripts/sync-locales.mjs",
    "test": "npm run check:locales && npx --yes tsx --test lib/messaging/__tests__/*.test.ts lib/__tests__/*.test.ts",
    "test:messaging": "npm run test",
    "release:env": "node scripts/verify-production-config.mjs"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-virtual": "^3.14.8",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.33.0",
    "heic2any": "^0.0.4",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "libphonenumber-js": "^1.12.38",
    "lucide-react": "^0.563.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-easy-crop": "^5.4.2",
    "react-phone-number-input": "^3.4.17",
    "sanitize-html": "^2.17.6",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "25.1.0",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.4.16",
    "eslint": "10.8.0",
    "postcss": "8.5.24",
    "tailwindcss": "^3.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "form-data": "4.0.6",
    "nanoid": "3.3.17",
    "postcss": "8.5.24",
    "serialize-javascript": "7.0.7",
    "next": {
      "sharp": "0.35.3"
    }
  }
}
