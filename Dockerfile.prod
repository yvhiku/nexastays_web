FROM node:22-alpine AS build
WORKDIR /app

ARG NEXT_PUBLIC_IDENTITY_API_BASE_URL=https://identity.nexastays.ma/api/v1
ARG NEXT_PUBLIC_STAYS_API_BASE_URL=https://api.nexastays.ma/api/v1
ARG NEXT_PUBLIC_SITE_URL=https://nexastays.ma
ARG NEXT_PUBLIC_STAYS_PAYMENT_PROVIDER=mock

ENV NEXT_PUBLIC_IDENTITY_API_BASE_URL=${NEXT_PUBLIC_IDENTITY_API_BASE_URL}
ENV NEXT_PUBLIC_STAYS_API_BASE_URL=${NEXT_PUBLIC_STAYS_API_BASE_URL}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_STAYS_PAYMENT_PROVIDER=${NEXT_PUBLIC_STAYS_PAYMENT_PROVIDER}

COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/package.json /app/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
RUN addgroup -S nexa && adduser -S -G nexa nexa && chown -R nexa:nexa /app
USER nexa
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:3000/en',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
CMD ["npm", "start"]
