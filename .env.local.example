# Public API base URLs only — safe for the browser bundle.
# Never put secrets, API keys, DB passwords, or OTP codes in NEXT_PUBLIC_* vars.
#
# Cookie sessions (HttpOnly nexa_refresh) require SAME SITE as the page origin.
# If you open http://localhost:3005, APIs must be http://localhost:… — not 127.0.0.1.
# Mixing localhost and 127.0.0.1 makes the browser treat refresh as cross-site and
# drops SameSite=Lax cookies → every page reload looks like a logout.

NEXT_PUBLIC_IDENTITY_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_STAYS_API_BASE_URL=http://localhost:3002/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Production `npm run build` (NODE_ENV=production) refuses loopback hosts for the three
# NEXT_PUBLIC_* URLs above — see lib/env.ts resolvePublicServiceUrl. That is intentional.
# Local .env.local values are correct for `npm run dev` and will correctly fail a release
# build. For a production build, override with non-loopback HTTPS URLs (shell env wins over
# .env.local), e.g.:
#
#   NEXT_PUBLIC_SITE_URL=https://www.nexastays.ma \
#   NEXT_PUBLIC_IDENTITY_API_BASE_URL=https://identity.example/api/v1 \
#   NEXT_PUBLIC_STAYS_API_BASE_URL=https://stays.example/api/v1 \
#   npm run build
#
# Release certification also requires analytics/error endpoints and a non-mock payment
# provider — run: npm run release:env
# See .env.production.example for the full production contract template.

# Match backend/stays STAYS_PAYMENT_PROVIDER (mock for testing, cmi for production gateway).
NEXT_PUBLIC_STAYS_PAYMENT_PROVIDER=mock

# Enable service worker in local dev (set to true to disable PWA during hot-reload debugging).
# NEXT_PUBLIC_DISABLE_PWA=true

# Optional first-party analytics endpoint for funnel events.
# Leave unset to log events locally in development.
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://example.com/api/analytics/events

# Required for production release certification. Receives sanitized client-error
# envelopes only; no tokens, request payloads, stack traces, or user identifiers.
# NEXT_PUBLIC_ERROR_REPORTING_ENDPOINT=https://example.com/api/client-errors

# Legacy single-backend URL (remove once web/mobile clients are updated)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
